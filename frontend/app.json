{
  "expo": {
    "name": "JuanLMS",
    "slug": "juanlms-mobile-app",
    "owner": "kneelpngnbn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/SanJuan.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/JuanLMS-LogoV1.png",
      "resizeMode": "contain",
      "backgroundColor": "#03045E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kneelpngnbn.juanlms.mobileapp",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to camera to take profile pictures.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photos to let you share them with your friends.",
        "NSMicrophoneUsageDescription": "This app needs access to microphone for audio features.",
        "NSUserNotificationsUsageDescription": "This app sends notifications for important updates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/SanJuan.png",
        "backgroundColor": "#03045E"
      },
      "package": "com.kneelpngnbn.juanlms.mobileapp",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": true,
      "usesCleartextTraffic": true,
      "buildConfigFields": {
        "androidx.core:core": "1.13.1",
        "androidx.media:media": "1.0.0"
      }
    },
    "web": {
      "icon": "./assets/SanJuan.png"
    },
    "extra": {
      "API_URL": "https://juanlms-webapp-server.onrender.com",
      "eas": {
        "projectId": "532b08d3-fefb-4900-87c6-fdb1fcd560da"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends.",
          "cameraPermission": "The app accesses your camera to let you take profile pictures."
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "androidMode": "default"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/SanJuan.png",
      "color": "#00418b"
    }
  }
}
