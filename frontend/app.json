          }
        ],
        "GOOGLE_APP_ID": "1:460357912009:ios:e649f8a5883b6e2914d418",
        "GCM_SENDER_ID": "460357912009",
        "API_KEY": "AIzaSyA1kTF1kFuVEIM-VP0oVfXwf_CR53s3_P4",
        "PROJECT_ID": "juanlms-pushnotf",
        "STORAGE_BUCKET": "juanlms-pushnotf.firebasestorage.app"
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/SanJuan.png",
        "backgroundColor": "#03045E"
      },
      "package": "com.kneelpngnbn.juanlms.mobileapp",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": true,
      "usesCleartextTraffic": true,
      "buildConfigFields": {
        "androidx.core:core": "1.13.1",
        "androidx.media:media": "1.0.0"
      }
    },
    "web": {
      "icon": "./assets/SanJuan.png"
    },
    "extra": {
      "API_URL": "https://juanlms-webapp-server.onrender.com",
      "eas": {
        "projectId": "46c7f7e3-43e9-444e-801e-dc9671e88f35"
      }
    },
    "plugins": [
