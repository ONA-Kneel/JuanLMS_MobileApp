{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://juanlms-webapp-server.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "hooks": {
        "preInstall": "./eas-build-pre-install.sh"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://juanlms-webapp-server.onrender.com"
      }
    },
    "production": {
          "distribution": "store",
          "android": {
            "buildType": "apk",
            "gradleCommand": ":app:assembleRelease"
          },
          "ios": {
            "buildConfiguration": "Release"
          },
          "hooks": {
            "preInstall": "./eas-build-pre-install.sh"
          },
          "env": {
            "EXPO_PUBLIC_API_URL": "https://juanlms-webapp-server.onrender.com"
          }
        }
  },
  "submit": {
    "production": {}
  }
} 