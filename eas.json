{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
         "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://juanlms-webapp-server.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
     "ios": {
    "buildConfiguration": "Release",
    "simulator": false,
    "buildSettings": {
      "USE_FRAMEWORKS": "STATIC",
      "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES"
      }
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://juanlms-webapp-server.onrender.com"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "buildConfiguration": "Release",
        "simulator": false,
        "buildSettings": {
          "ENABLE_BITCODE": "NO",
          "VALID_ARCHS": "arm64",
          "USE_FRAMEWORKS": "STATIC",
          "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES",
          "USE_MODULAR_HEADERS": "YES"
        },
        "useModularHeaders": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://juanlms-webapp-server.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}